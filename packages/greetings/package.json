{
  "name": "@metamask/greetings",
  "version": "0.0.0",
  "description": "Example package containing greeting-based utilities",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/metamask-monorepo-template/tree/main/packages/greetings#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/metamask-monorepo-template/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/metamask-monorepo-template.git"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "ts-bridge --project tsconfig.build.json --verbose --clean --no-references",
    "build:all": "ts-bridge --project tsconfig.build.json --verbose --clean",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/greetings",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/greetings",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.1.0",
    "@ts-bridge/cli": "^0.6.4",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typedoc": "^0.25.13",
    "typescript": "~5.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20 || >=22"
  }
}
